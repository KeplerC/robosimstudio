{
  "version": 3,
  "meta": {
    "name": "rgbs_peel_gt",
    "description": "Peel the adhesive strip off the box. Perception is a slot with two bodies behind a router: sim.get_tab reads the tab off the particles, and a camera body is declared and skipped because open-robot-skills is absent here. The peel itself is five legs the graph plans as it flies them -- two joint-space transits, two straight strokes at the tab -- with the wrist chosen once, up front, by whether the arm can hold it where it matters. The film is carried by sim.attach because closing rigid fingers on a sub-millimetre sheet does not grip it, and the layout's own pull-tab pin is released only after the hold is proven."
  },
  "nodes": {
    "perceive_tab": {
      "type": "router",
      "script": "scripts/route_perception.py",
      "inputs": {
        "perception": {
          "$ref": "in.perception"
        }
      }
    },
    "perceive_tab_oracle": {
      "type": "subgraph",
      "ref": "perceive_tab_oracle_sg"
    },
    "perceive_tab_vision": {
      "type": "subgraph",
      "ref": "perceive_tab_vision_sg"
    },
    "peel": {
      "type": "subgraph",
      "ref": "peel_sg"
    },
    "verify": {
      "type": "subgraph",
      "ref": "verify_sg"
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "sim.detach",
          "inputs": {}
        },
        {
          "tool": "robot.open_gripper",
          "inputs": {}
        }
      ]
    }
  },
  "edges": [
    [
      "START",
      "perceive_tab"
    ]
  ],
  "conditional_edges": {
    "perceive_tab": {
      "router_field": null,
      "mapping": {
        "oracle": "perceive_tab_oracle",
        "vision": "perceive_tab_vision"
      }
    },
    "perceive_tab_oracle": {
      "router_field": "exit",
      "mapping": {
        "found": "peel",
        "not_found": "abort",
        "errored": "abort"
      }
    },
    "perceive_tab_vision": {
      "router_field": "exit",
      "mapping": {
        "found": "peel",
        "not_found": "abort",
        "errored": "abort"
      }
    },
    "peel": {
      "router_field": "exit",
      "mapping": {
        "lifted": "verify",
        "missed": "abort",
        "unreachable": "abort",
        "errored": "abort"
      }
    },
    "verify": {
      "router_field": "exit",
      "mapping": {
        "peeled": "done",
        "partial": "abort"
      }
    }
  },
